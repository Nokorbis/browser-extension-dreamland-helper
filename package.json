{
  "name": "dreamland-reborn-qol",
  "displayName": "Dreamland Reborn QoL",
  "description": "Writing aids for PHPBB 3.20 roleplay forums: exit guard, text highlighting, BBCode presets, color grabbing, keyboard shortcuts, and an emoji picker.",
  "private": true,
  "version": "1.0.2",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "gen:emoji": "node scripts/gen-emoji.mjs",
    "test": "vitest run",
    "release": "bash scripts/release.sh",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@wxt-dev/i18n": "^0.2.6",
    "@wxt-dev/module-svelte": "^2.0.5",
    "emojibase-data": "^17.0.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.10.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.7",
    "svelte-check": "^4.7.3",
    "svelte-eslint-parser": "^1.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10",
    "wxt": "^0.20.27"
  }
}
