{
  "name": "dreamland-helper",
  "displayName": "Dreamland Reborn QoL",
  "description": "Writing aids for PHPBB 3.20 roleplay forums: exit guard, GM-text highlighting, BBCode presets, and color grabbing.",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "release": "bash scripts/release.sh",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@wxt-dev/i18n": "^0.2.6",
    "@wxt-dev/module-svelte": "^2.0.5",
    "svelte": "^5.56.7",
    "svelte-check": "^4.7.3",
    "typescript": "^5.9.3",
    "wxt": "^0.20.27"
  }
}
